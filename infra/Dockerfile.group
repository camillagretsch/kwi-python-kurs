FROM codercom/example-base:ubuntu

# Run below commands as root user
USER root

ENV DEBIAN_FRONTEND=noninteractive

# Basic tools and Python
RUN apt-get update && apt-get install -y \
  python3 \
  python3-venv \
  python3-pip \
  git \
  curl \
  sudo \
  locales \
  && rm -rf /var/lib/apt/lists/*
  
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Jupyter + ipykernel 
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
      jupyter \
      ipykernel \
      notebook

# Projektordner vorbereiten
RUN mkdir -p /home/coder/project && \
    chown -R coder:coder /home/coder/project
    
USER coder

WORKDIR /home/coder/project

# Kernel explizit aus dem venv registrieren
RUN /opt/venv/bin/python -m ipykernel install --user \
    --name kwi-python \
    --display-name "Python (KWI)"
